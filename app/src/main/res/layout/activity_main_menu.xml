<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/doom_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Game Title -->
        <TextView
            android:id="@+id/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_menu_title"
            android:textColor="@color/doom_red"
            android:textSize="48sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:shadowColor="@color/doom_blood"
            android:shadowDx="4"
            android:shadowDy="4"
            android:shadowRadius="8" />

        <TextView
            android:id="@+id/text_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_menu_subtitle"
            android:textColor="@color/doom_yellow"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:layout_marginBottom="16dp" />

        <!-- High Score Display -->
        <TextView
            android:id="@+id/text_high_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/high_score_label"
            android:textColor="@color/doom_green"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp"
            android:shadowColor="@color/black"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="3" />

        <!-- Menu Buttons -->
        <LinearLayout
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <Button
                android:id="@+id/btn_play"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="12dp"
                android:text="@string/button_play"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/doom_dark_red" />

            <Button
                android:id="@+id/btn_settings"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:text="@string/button_settings"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/doom_gray" />

            <Button
                android:id="@+id/btn_how_to_play"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/button_how_to_play"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/doom_gray" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
